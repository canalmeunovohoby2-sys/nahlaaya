{
  "name": "nahla-aya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,yellow \"vite --port 5174\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --port 5174",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsc --noEmit -p tsconfig.server.json",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "build:web": "vite build",
    "migration:export": "node scripts/migration/export-sqlite.mjs",
    "migration:validate": "node scripts/migration/validate-export.mjs",
    "test:visits": "tsx --test tests/visits.test.ts",
    "test:checkout": "tsx --test tests/checkout-storage.test.ts",
    "test:melhor-envio": "tsx --test tests/melhor-envio-oauth.test.ts",
    "test:shipping": "tsx --test tests/shipping-product-preservation.test.ts",
    "test:shipping-package": "tsx --test tests/shipping-package.test.ts",
    "test:shipping-quote": "tsx --test tests/shipping-quote.test.ts",
    "test:shipping-defaults": "tsx --test tests/shipping-defaults.test.ts",
    "test:mercadopago": "tsx --test tests/mercadopago.test.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@mercadopago/sdk-js": "^0.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
